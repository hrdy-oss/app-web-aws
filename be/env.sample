# Salin menjadi be/.env lalu isi nilainya. Jangan di-commit.
APP_TIMEZONE=Asia/Jakarta
DEBUG_MODE=false

# Secret untuk JWT (acak, minimal 16 karakter). Contoh membuat: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang

# RDS MySQL
DB_HOST=endpoint-rds-kamu.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=kasir_db
DB_USER=admin
DB_PASS=password-rds-kamu

# S3 (foto menu). Learner Lab hanya mengizinkan us-east-1 / us-west-2.
AWS_REGION=us-east-1
AWS_S3_BUCKET=nama-bucket-kamu
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Wajib untuk Learner Lab (kredensial sementara). Kosongkan jika memakai key IAM biasa.
AWS_SESSION_TOKEN=
